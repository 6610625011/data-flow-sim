# Path to the pvsim (sim-daniel) repo (sibling directory by default)
PVSIM_PATH=../sim-daniel

# Copy to ".env" (same folder as docker-compose.yml) and change the values.
# Without a .env file the defaults in docker-compose.yml are used - fine for a laptop
# simulation, but change every password/token before the server is reachable by others.

# --- MQTT account for devices (ESP32, Wokwi bridge, MQTT Explorer) on port 1883
MQTT_USER=esp32
MQTT_PASSWORD=esp32-sim-2026

# --- InfluxDB (only read on the FIRST start; to change later use the InfluxDB UI or
#     delete the volume: docker compose down -v)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=solar-admin-2026
INFLUX_ORG=solar
INFLUX_TOKEN=solar-sim-token-change-me
# empty = keep raw 1-s data forever; e.g. 180d to keep six months
INFLUX_RAW_RETENTION=

# --- Node-RED
NODE_RED_CREDENTIAL_SECRET=solar-sim-credential-secret
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD=solar-admin-2026
# dashboard login for group members (empty = no login; set one before using the public tunnel)
DASHBOARD_USER=group
DASHBOARD_PASSWORD=
# PIN to send commands / set labels from the dashboard (empty = no PIN)
CONTROL_PIN=2468

# --- virtual ESP32 boards
SIM_START=now
SIM_SPEED=1
SIM_SKY=partly_cloudy
SIM_SEED=1
SIM_MPPT=po
SIM_BUFFER=600
SIM_KEEPALIVE=10
# boards the simulator plays: fixed,track (both) or fixed when ESP32 #2 runs in Wokwi
SIM_NODES=fixed,track
